{
  "name": "gambri-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,green \"vite\" \"npm:api\"",
    "web": "vite",
    "api": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "api:start": "tsx --env-file-if-exists=.env server/index.ts",
    "db:setup": "tsx --env-file-if-exists=.env server/seed.ts",
    "db:sync": "tsx --env-file-if-exists=.env server/seed.ts --sync",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.13.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "mysql2": "^3.24.6",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
