# copy to .env and adjust
API_PORT=8787
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gnawa
# flat delivery fee in MAD (0 until real rates are set)
SHIPPING_FLAT_MAD=0
CORS_ORIGIN=http://localhost:5173
# the public address of the site (payment gateways send visitors back here)
PUBLIC_URL=http://localhost:5173
# set when the API sits behind nginx / a hosting proxy (Express "trust proxy")
# TRUST_PROXY=1

# ---- admin (/admin/reviews) — a long random string; admin is closed while empty
ADMIN_TOKEN=

# ---- card payment: CMI 3D Pay Hosting (credentials from your bank / CMI)
CMI_CLIENT_ID=
CMI_STORE_KEY=
# test gateway; production: https://payment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# ---- PayPal (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# PayPal does not settle MAD: totals are converted to this currency…
PAYPAL_CURRENCY=EUR
# …at this rate (dirhams per 1 unit of PAYPAL_CURRENCY). PayPal stays off while 0
PAYPAL_MAD_RATE=0
# unpaid online orders give their stock back after this many minutes
UNPAID_HOLD_MINUTES=60

# ---- analytics (front end; restart `npm run dev` after changing)
# Plausible: the domain registered in Plausible, e.g. gnawa.ma (cookieless, no banner)
VITE_PLAUSIBLE_DOMAIN=
# self-hosted Plausible: point at your script.manual.js
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (asks visitors for cookie consent)
VITE_GA_ID=
